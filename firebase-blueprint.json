{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "Electronics product category and subcategory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "parentId": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Consumer electronics product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "subcategory": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discount": { "type": "number" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "images": { "type": "array" },
        "specifications": { "type": "object" },
        "featured": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "brand", "categoryId", "price", "stock"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Customer wishlist item linking user and product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Customer cart containing line items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "items"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with details, payment simulation and shipment status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["UPI Simulation", "Card Simulation", "Cash on Delivery Simulation"] },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "total", "status", "paymentMethod", "items", "shippingAddress"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review by verified customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "productId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user credentials and profile information"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Electronics categories and subcategories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of consumer electronics with specs and stock"
    },
    "/wishlists/{wishlistId}": {
      "schema": "Wishlist",
      "description": "Customer wishlist entries"
    },
    "/carts/{cartId}": {
      "schema": "Cart",
      "description": "Customer shopping cart states"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Completed customer orders and statuses"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product ratings and reviews"
    }
  }
}
